                "1"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            },
            "description": "Returns 409 if the SKU already exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"KIT-KNF-040\",\n  \"name\": \"Chef Knife\",\n  \"category\": \"Kitchen\",\n  \"quantity\": 5,\n  \"reorder_threshold\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update item 1",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                "1"
              ]
            },
            "description": "quantity is not patchable: it only changes through a stock movement.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reorder_threshold\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Deactivate item 1",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/items/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                "1"
              ]
            },
            "description": "Soft delete. History is preserved."
          }
        },
        {
          "name": "Reactivate item 1",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/items/1/reactivate",
