{
  "info": {
    "name": "Retail Inventory System - API v1",
    "description": "Inventory API for Cornerline Home Goods.\n\nSet the `base_url` variable to your running server (default http://127.0.0.1:8000).\n\nThe caller is simulated with the `X-User-Name` and `X-User-Role` headers. Valid roles: STORE_STAFF, STORE_MANAGER, OWNER. Manual adjustments require STORE_MANAGER or OWNER.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
